[node name="Background" parent="Root" instance=ExtResource("2_bg")]
layout_mode = 1

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Box" type="VBoxContainer" parent="Root/Center"]
layout_mode = 2
