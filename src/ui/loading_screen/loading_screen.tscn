[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/loading_screen/loading_screen.gd" id="1_ls"]
[ext_resource type="PackedScene" path="res://src/ui/background/neon_background.tscn" id="2_bg"]
[ext_resource type="Theme" path="res://src/ui/theme/goofy_theme.tres" id="3_th"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_track"]
bg_color = Color(0, 0, 0, 0.45)
corner_radius_top_left = 7
corner_radius_top_right = 7
corner_radius_bottom_right = 7
corner_radius_bottom_left = 7

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_fill"]
