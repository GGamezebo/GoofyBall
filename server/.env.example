# Copy to .env and change every value before exposing port 7350 to the internet.
POSTGRES_DB=nakama
POSTGRES_PASSWORD=change_me_pg
NAKAMA_VERSION=3.37.0
NAKAMA_CONSOLE_USERNAME=admin
NAKAMA_CONSOLE_PASSWORD=change_me_console
# Must match the game: OnlineConfig.server_key (src/features/online/online_config.tres)
# or `server_key` in user://online.cfg on every player device.
NAKAMA_SERVER_KEY=goofyball_dev_key
NAKAMA_SESSION_KEY=change_me_session_key
NAKAMA_REFRESH_KEY=change_me_refresh_key
NAKAMA_CONSOLE_SIGNING_KEY=change_me_console_signing_key
NAKAMA_HTTP_KEY=change_me_http_key
