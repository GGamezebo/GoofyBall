# Godot 4
.godot/
.nomedia
export.cfg
export_credentials.cfg
*.tmp
*.translation

# Builds
/build/
/export/

# Secrets (never commit)
.env
*.keystore
*.jks
*.p12
*.pem

# Claude Code local state
.claude/settings.local.json

# Python (concept generators)
__pycache__/
*.pyc

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Public CI debug keystore (password "android") — intentionally committed
!ci/debug.keystore

# Export output
/bin/

# Developer's own Nakama address baked into local builds (see online_local.tres.example)
/online_local.tres
# Editor hot-reload copies of GDExtension libraries
addons/*/lib/~*
